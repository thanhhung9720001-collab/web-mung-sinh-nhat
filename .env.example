# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Public origin of the current environment. Use the deployed HTTPS origin in
# production and do not add a trailing slash.
APP_URL=http://localhost:3000

# All deadlines are interpreted in this IANA time zone.
APP_TIME_ZONE=Asia/Ho_Chi_Minh
CONTRIBUTIONS_CLOSE_AT=2026-09-15T23:59:00+07:00
GIFT_OPENS_AT=2026-09-17T00:00:00+07:00

# -----------------------------------------------------------------------------
# Supabase — server only
# -----------------------------------------------------------------------------

SUPABASE_URL=https://your-project-ref.supabase.co

# Create a modern sb_secret_... key in Supabase Dashboard > Settings > API Keys.
# This key bypasses RLS. Never prefix it with NEXT_PUBLIC_ or expose it to the
# browser, logs, source control, screenshots, or client-side error messages.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# -----------------------------------------------------------------------------
# Private access — server only
# -----------------------------------------------------------------------------

# Store password hashes only. Never place plaintext passwords in environment
# files. The hashing algorithm and commands will be defined with authentication.
GIFT_PASSWORD_HASH=replace_with_generated_password_hash
ADMIN_PASSWORD_HASH=replace_with_generated_password_hash

# Random secret used to sign application sessions. Generate at least 32 random
# bytes and encode them as base64url.
SESSION_SECRET=replace_with_at_least_32_random_bytes
ADMIN_SESSION_TTL_SECONDS=28800

# Keep the gift session isolated from the admin session.
GIFT_SESSION_SECRET=replace_with_at_least_32_random_bytes
GIFT_SESSION_TTL_SECONDS=86400

# Independent HMAC key for private per-wish edit links. Rotating it revokes all
# outstanding contributor edit links.
WISH_EDIT_SECRET=replace_with_at_least_32_random_bytes

# Random, unguessable URL-safe segment used by /contribute/[secret]. Use at
# least 32 characters. Missing, placeholder, or shorter values deny all access.
CONTRIBUTION_LINK_SECRET=replace_with_random_url_safe_secret

# Basic abuse protection. Counters are shared in Supabase and keyed by an HMAC
# digest, so raw visitor IP addresses are not stored.
CONTRIBUTION_RATE_LIMIT_MAX=5
CONTRIBUTION_RATE_LIMIT_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Media rules
# -----------------------------------------------------------------------------

AVATAR_BUCKET=wish-avatars
VIDEO_BUCKET=wish-videos
MAX_AVATAR_SIZE_BYTES=5242880
MAX_VIDEO_SIZE_BYTES=31457280
MAX_VIDEO_DURATION_SECONDS=60

# Signed media URLs should be short-lived. Five minutes is the initial default.
SIGNED_URL_TTL_SECONDS=300
